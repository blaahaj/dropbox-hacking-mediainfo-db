{
  "name": "@blaahaj/dropbox-hacking-mediainfo-db",
  "version": "1.3.0",
  "description": "Extract and store mediainfo information from videos in Dropbox",
  "keywords": [],
  "license": "ISC",
  "author": "Rachel Evans <rachel@rachelevans.org>",
  "files": [
    "dist/src/",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./dist/src/index.js",
    "./types": "./dist/src/types.js"
  },
  "main": "index.js",
  "repository": {
    "url": "https://github.com/blaahaj/dropbox-hacking-mediainfo-db"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "format": "std-fix-npmPkgJsonLint && eslint --fix --fix-type layout src test && prettier --write --list-different .",
    "test": "concurrently --group=true pnpm:test:\\*",
    "test:format": "prettier --check .",
    "test:lint": "eslint src test",
    "test:package-json": "npmPkgJsonLint .",
    "test:unit": "c8 node --test --enable-source-maps './dist/test/*.test.js'"
  },
  "dependencies": {
    "@blaahaj/dropbox-hacking-downloader": "^1.0.1",
    "@blaahaj/dropbox-hacking-lister": "^1.0.0",
    "@blaahaj/dropbox-hacking-util": "^1.2.0",
    "dropbox": "^10.34.0"
  },
  "devDependencies": {
    "@blaahaj/std": "^1.0.3",
    "@commitlint/config-conventional": "^19.8.1",
    "@commitlint/types": "^19.8.1",
    "@eslint/js": "^9.31.0",
    "@types/eslint__js": "^8.42.3",
    "@types/node": "^26.2.0",
    "@types/tmp": "^0.2.6",
    "c8": "^10.1.3",
    "concurrently": "^9.2.0",
    "eslint": "^10.5.0",
    "npm-package-json-lint": "^10.4.1",
    "npm-package-json-lint-config-default": "^9.0.1",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.65.0"
  },
  "optionalDependencies": {
    "yargs": ">=17.7.3"
  }
}
